{
  "protocol": {
    "id": "KELP-EWS-JOURNAL-EXT-v1.0",
    "date": "2026-08-14",
    "classification": "pilot_informed_reviewer_robustness",
    "preregistration": false,
    "purpose": "Test whether the locked 165-cell conclusions survive conventional-versus-operational evaluation, fixed model-family changes, monitoring-budget variation, and outcome/eligibility sensitivity."
  },
  "inputs": {
    "panel": "data/processed/kelpwatch_west_coast_panel_165.csv",
    "environment": "outputs/experiments/20260814_minimal_paper_extension_v2/environment_features.csv"
  },
  "time": {
    "train_start_year": 1989,
    "first_forecast_year": 2005,
    "last_forecast_year": 2024
  },
  "information_blocks": {
    "trajectory": [
      "canopy_lag1",
      "canopy_lag2",
      "canopy_2yr_change",
      "canopy_3yr_change",
      "canopy_3yr_mean",
      "canopy_3yr_std",
      "canopy_3yr_slope",
      "canopy_drop_from_3yr_max"
    ],
    "oisst": [
      "annual_mean_sst_anomaly",
      "annual_max_sst",
      "hot_weeks_p90",
      "winter_mean_sst_anomaly",
      "summer_mean_sst_anomaly",
      "lag1_annual_mean_sst_anomaly"
    ],
    "cuti_beuti": [
      "winter_cuti_anomaly",
      "spring_cuti_anomaly",
      "winter_beuti_anomaly",
      "spring_beuti_anomaly",
      "upwelling_season_beuti_anomaly"
    ]
  },
  "evaluation_protocol_comparison": {
    "operational": "expanding_window",
    "conventional": "repeated_random_cell_year_cv",
    "conventional_folds": 5,
    "conventional_repeats": 20,
    "conventional_limitation": "Random folds permit future years and repeated observations from the same cells to inform training. They are included only to quantify evaluation optimism, not as a valid deployment estimate.",
    "aggregations": [
      "pooled_average_precision_lift",
      "macro_within_year_average_precision_lift"
    ]
  },
  "model_family_robustness": {
    "selection": "fixed_prespecified_not_tuned_on_outer_results",
    "families": {
      "logistic": {"C": 1.0},
      "random_forest": {
        "n_estimators": 400,
        "max_depth": 5,
        "min_samples_leaf": 10,
        "max_features": "sqrt"
      },
      "xgboost": {
        "n_estimators": 300,
        "max_depth": 3,
        "learning_rate": 0.03,
        "min_child_weight": 5,
        "subsample": 0.9,
        "colsample_bytree": 0.9,
        "reg_lambda": 1.0
      }
    },
    "class_weight": null,
    "resampling": null
  },
  "decision_budget": {
    "fractions": [0.05, 0.10, 0.20, 0.30],
    "rounding": "ceiling_with_minimum_one_cell_per_year",
    "metric": "micro_event_recall_across_year_specific_rankings"
  },
  "sensitivity": {
    "decline_fractions": [0.20, 0.30, 0.40],
    "eligibility_relative_canopy_gt": [0.02, 0.05, 0.10],
    "model_family": "logistic",
    "prohibit_ecological_collapse_language": true
  },
  "uncertainty": {
    "year_block_bootstrap_replicates": 2000,
    "confidence_level": 0.95,
    "random_split_interval": "empirical_2.5_to_97.5_percentiles_across_repeats"
  },
  "reproducibility": {
    "random_seed": 20260814,
    "overwrite_runs": false,
    "save_prediction_level_outputs": true,
    "save_input_and_output_hashes": true,
    "log_git_sha": true
  }
}
