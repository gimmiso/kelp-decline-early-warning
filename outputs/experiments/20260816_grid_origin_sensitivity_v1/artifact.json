  "sources": [
    {
      "id": "grid_results",
      "label": "격자 민감도 결과표",
      "path": "outputs/experiments/20260816_grid_origin_sensitivity_v1/grid_sensitivity_results.csv",
      "query": {
        "language": "sql",
        "description": "20개 격자 사양의 미래예측 성능, 부트스트랩 구간, 코호트 및 공간 일치도를 결합한 검증 결과표.",
        "tables_used": [
          "grid_sensitivity_results"
        ],
        "filters": [
          "공식 Kelpwatch 2026 Q2 NetCDF",
          "1984–2004 양성 픽셀 고정 footprint",
          "관측 유효면적 ≥50%, 유효 분기 ≥3, Q3 필수",
          "2005–2024 expanding-window 평가",
          "다음 해 연간 최대 캐노피 30% 이상 감소"
        ],
        "metric_definitions": {
          "current_lift": "연도별 AP에서 해당 연도 사건률을 뺀 값의 20개 연도 macro 평균.",
          "trajectory_increment": "동일 표본에서 current+trajectory AP lift와 current-only AP lift의 연도별 차이 평균.",
          "oisst_increment": "OISST 지원 동일 표본에서 trajectory+OISST와 current+trajectory AP lift의 연도별 차이 평균."
        },
        "engine": "sqlite",
        "sql": "SELECT * FROM grid_sensitivity_results\nWHERE threshold_policy = 'area_scaled'\nORDER BY grid_size_km,\nCASE origin_name WHEN 'o00' THEN 1 WHEN 'ox50' THEN 2 WHEN 'oy50' THEN 3 ELSE 4 END"
      }
    },
    {
      "id": "spatial_agreement",
      "label": "픽셀 가중 공간 일치도",
      "path": "outputs/experiments/20260816_grid_origin_sensitivity_v1/grid_sensitivity_results.csv",
      "query": {
        "language": "sql",
        "description": "공통 pre-2005 양성 30m 픽셀-연도에서 급감 라벨과 상위 20% 조사영역의 Jaccard를 계산.",
        "tables_used": [
          "grid_sensitivity_results"
        ],
        "filters": [
          "공식 Kelpwatch 2026 Q2 NetCDF",
          "1984–2004 양성 픽셀 고정 footprint",
          "관측 유효면적 ≥50%, 유효 분기 ≥3, Q3 필수",
          "2005–2024 expanding-window 평가",
          "다음 해 연간 최대 캐노피 30% 이상 감소"
        ],
        "metric_definitions": {
          "label_jaccard": "두 격자 모두 급감으로 분류한 픽셀-연도 / 적어도 한 격자가 급감으로 분류한 픽셀-연도.",
          "top20_jaccard": "두 격자의 상위 20% 조사 셀에 동시에 포함된 공통 픽셀-연도 / 어느 한쪽에 포함된 공통 픽셀-연도."
        },
        "engine": "sqlite",
        "sql": "SELECT * FROM grid_sensitivity_results\nWHERE threshold_policy = 'area_scaled'\nORDER BY grid_size_km,\nCASE origin_name WHEN 'o00' THEN 1 WHEN 'ox50' THEN 2 WHEN 'oy50' THEN 3 ELSE 4 END"
      }
    },
    {
      "id": "validation",
      "label": "독립 재검산 결과",
      "path": "outputs/experiments/20260816_grid_origin_sensitivity_v1/validation_recheck.csv",
      "query": {
        "language": "sql",
        "description": "예측확률·bootstrap draw·픽셀 혼동행렬·manifest hash에서 결과를 독립 재검산한 25개 검사.",
        "tables_used": [
          "validation_recheck"
        ],
        "filters": [
          "25개 사전 정의 정합성 검사"
        ],
        "engine": "sqlite",
        "sql": "SELECT \"check\", value, passed FROM validation_recheck ORDER BY \"check\""
      }
    },
    {
      "id": "headline_metrics",
      "label": "격자 강건성 핵심 지표",
      "path": "outputs/experiments/20260816_grid_origin_sensitivity_v1/grid_sensitivity_results.csv",
      "query": {
        "language": "sql",
        "engine": "sqlite",
        "sql": "WITH scaled AS (\n  SELECT * FROM grid_sensitivity_results WHERE threshold_policy = 'area_scaled'\n), origin_ranges AS (\n  SELECT grid_size_km, MAX(current_lift) - MIN(current_lift) AS origin_range\n  FROM scaled GROUP BY grid_size_km\n)\nSELECT\n  SUM(CASE WHEN current_ci_low > 0 THEN 1 ELSE 0 END) AS current_supported,\n  (SELECT MAX(origin_range) FROM origin_ranges) AS max_origin_range,\n  MIN(CASE WHEN spec_id <> 'g10_area_scaled_o00' THEN global_label_jaccard END) AS min_label,\n  MIN(CASE WHEN spec_id <> 'g10_area_scaled_o00' THEN global_top20_spatial_jaccard END) AS min_top20,\n  SUM(CASE WHEN trajectory_ci_low > 0 THEN 1 ELSE 0 END) AS trajectory_supported,\n  SUM(CASE WHEN oisst_ci_low > 0 THEN 1 ELSE 0 END) AS oisst_supported\nFROM scaled",
        "description": "면적비례 12개 격자의 지지 횟수, 원점 범위 및 최소 공간 Jaccard를 집계.",
        "tables_used": [
          "grid_sensitivity_results"
        ],
        "filters": [
          "공식 Kelpwatch 2026 Q2 NetCDF",
          "1984–2004 양성 픽셀 고정 footprint",
          "관측 유효면적 ≥50%, 유효 분기 ≥3, Q3 필수",
          "2005–2024 expanding-window 평가",
          "다음 해 연간 최대 캐노피 30% 이상 감소"
        ]
      }
    },
    {
      "id": "policy_results",
      "label": "footprint 기준 비교",
      "path": "outputs/experiments/20260816_grid_origin_sensitivity_v1/grid_sensitivity_results.csv",
      "query": {
        "language": "sql",
        "engine": "sqlite",
        "sql": "SELECT * FROM grid_sensitivity_results\nWHERE grid_size_km IN (5, 20)\nORDER BY grid_size_km, threshold_policy,\nCASE origin_name WHEN 'o00' THEN 1 WHEN 'ox50' THEN 2 WHEN 'oy50' THEN 3 ELSE 4 END",
        "description": "5km와 20km의 면적비례 및 500픽셀 고정 코호트를 선택.",
        "tables_used": [
          "grid_sensitivity_results"
        ],
        "filters": [
          "공식 Kelpwatch 2026 Q2 NetCDF",
          "1984–2004 양성 픽셀 고정 footprint",
          "관측 유효면적 ≥50%, 유효 분기 ≥3, Q3 필수",
          "2005–2024 expanding-window 평가",
          "다음 해 연간 최대 캐노피 30% 이상 감소",
          "grid_size_km IN (5, 20)"
        ]
      }
